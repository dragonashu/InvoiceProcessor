{
  "ConnectionStrings": {
    "Default": "Data Source=./data/invoice-processor.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "Email": {
      "Host": "",
      "Port": 993,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "PollSeconds": 30
    },
    "Storage": {
      "InboxRoot": "./data/inbox",
      "StoreRoot": "./data/store",
      "SourceFolder": "../samples"
    },
    "Extraction": {
      "EmbeddedTextThreshold": 100,
      "ValidationTolerance": 0.05
    },
    "Matching": {
      "MinConfidence": 0.75
    },
    "Orchestrator": {
      "Enabled": false,
      "BaseUrl": "",
      "ApiToken": "",
      "ProcessKey": "WinMentorPoster"
    }
  }
}
