@page "/Config"
@model InvoiceProcessor.Web.Pages.Config.IndexModel

<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
    <div class="page-header" style="margin-bottom: 0;">
        <h1 class="page-title">Configurare</h1>
        <p class="page-subtitle">Gestionare furnizori si mapare ERP</p>
    </div>
    <form method="post">
        <button type="submit" asp-page-handler="ClearInbox" class="btn btn-secondary" style="color: var(--c-danger);"
                onclick="return confirm('Esti sigur ca vrei sa stergi toate documentele si joburile din inbox?\n\nFurnizorii si catalogul vor ramane intacte.')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            Goleste inbox
        </button>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
    <div class="card">
        <div class="card-body">
            <div class="section-title" style="margin-top: 0;">Furnizori</div>
            @if (Model.Suppliers.Count == 0)
            {
                <div class="empty-state">
                    <p>Niciun furnizor configurat.</p>
                </div>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Nume detectat</th>
                            <th>Nume ERP</th>
                            <th>CUI / VAT</th>
                            <th>Aliasuri</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Suppliers)
                        {
                            <tr>
                                <td>@s.Name</td>
                                <td style="font-weight: 600; color: var(--c-primary);">@(s.ErpName ?? "-")</td>
                                <td style="font-family: var(--font-mono); font-size: 13px;">@(s.VatNo ?? "-")</td>
                                <td style="font-size: 13px;">@IndexModel.ParseAliases(s.AliasesJson)</td>
                                <td>
                                    <button type="button" class="btn btn-secondary edit-supplier-btn" style="padding: 4px 12px; font-size: 12px;"
                                            data-id="@s.Id"
                                            data-name="@s.Name"
                                            data-erp="@s.ErpName"
                                            data-vat="@s.VatNo"
                                            data-country="@s.Country"
                                            data-aliases="@IndexModel.ParseAliases(s.AliasesJson)"
                                            data-invoicetype="@s.InvoiceType"
                                            data-taxationtype="@s.TaxationType"
                                            data-transactiontype="@s.TransactionType">
                                        Editeaza
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="section-title" style="margin-top: 0;" id="formTitle">Adauga furnizor</div>
            <form method="post">
                <input type="hidden" name="EditId" id="editId" value="" />
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <label class="field-label">Nume detectat (din PDF)</label>
                        <input type="text" name="Name" id="nameInput" class="form-input" required placeholder="ex: CORTIZO S.A." />
                    </div>
                    <div>
                        <label class="field-label">Nume ERP</label>
                        <input type="text" name="ErpName" id="erpNameInput" class="form-input" placeholder="ex: Cortizo SA - furnizor aluminiu" />
                    </div>
                    <div>
                        <label class="field-label">CUI / VAT</label>
                        <input type="text" name="VatNo" id="vatInput" class="form-input" placeholder="ex: SK2020065685" />
                    </div>
                    <div>
                        <label class="field-label">Tara</label>
                        <input type="text" name="Country" id="countryInput" class="form-input" placeholder="ex: SK" />
                    </div>
                    <div>
                        <label class="field-label">Aliasuri (separate prin virgula)</label>
                        <input type="text" name="Aliases" id="aliasesInput" class="form-input" placeholder="ex: CORTIZO, Cortizo SA, ALUMINIOS CORTIZO" />
                    </div>
                    <div style="display: flex; gap: 12px;">
                        <div style="flex: 1;">
                            <label class="field-label">Tip factura</label>
                            <select name="InvoiceType" id="invoiceTypeInput" class="form-input">
                                <option value="Intern">Intern</option>
                                <option value="Import">Import</option>
                            </select>
                        </div>
                        <div style="flex: 1;">
                            <select name="TaxationType" id="taxationTypeInput" class="form-input" style="margin-top: 22px;">
                                <option value="TaxareNormala">Taxare normala</option>
                                <option value="TaxareInversa">Taxare inversa</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="field-label">Tip Tranzactie</label>
                        <select name="TransactionType" id="transactionTypeInput" class="form-input">
                            <option value="TranzactieInterna">Tranzactie interna</option>
                            <option value="AchizitieIntracomunitara">Achizitie intracomunitara</option>
                        </select>
                    </div>
                    <div class="actions-bar" style="border-top: none; padding-top: 0;">
                        <button type="submit" asp-page-handler="Save" class="btn btn-primary" id="saveBtn">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                            <span id="saveBtnText">Adauga</span>
                        </button>
                        <button type="submit" asp-page-handler="Delete" class="btn btn-secondary" style="color: var(--c-danger); display: none;" id="deleteBtn"
                                onclick="return confirm('Dezactivezi acest furnizor?')">
                            Sterge
                        </button>
                        <button type="button" class="btn btn-secondary" style="display: none;" id="cancelBtn">Anuleaza</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px;">
    <div class="card">
        <div class="card-body">
            <div class="section-title" style="margin-top: 0;">Catalog articole ERP</div>
            <div class="stat-cards" style="grid-template-columns: 1fr 1fr; margin-bottom: 16px;">
                <div class="stat-card">
                    <div class="stat-card-label">Articole in catalog</div>
                    <div class="stat-card-value" style="font-size: 22px;">@Model.CatalogItemCount</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">Mapari furnizor-articol</div>
                    <div class="stat-card-value" style="font-size: 22px;">@Model.MappingCount</div>
                </div>
            </div>
            <div style="margin-bottom: 16px;">
                <label class="field-label">Cauta in catalog (cod sau denumire)</label>
                <input type="text" id="catalogSearchInput" class="form-input" placeholder="ex: EF230, PROFILE, 7016..." style="margin-bottom: 8px;" />
                <div id="catalogSearchResults" style="display:none; max-height: 250px; overflow-y: auto; border: 1px solid var(--c-border); border-radius: var(--radius); background: var(--c-surface);"></div>
            </div>

            <form method="post" asp-page-handler="ImportCatalog" enctype="multipart/form-data">
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <label class="field-label">Import / Actualizare catalog (XLSX)</label>
                        <p style="font-size: 12px; color: var(--c-text-muted); margin-bottom: 8px;">
                            Incarca fisierul implicit <code>Nomenclator articole.XLSX</code>. Randurile de antet si cele libere sunt ignorate automat.<br/>
                            Se importa primele 4 coloane: <code>UM</code>, <code>CODOBIECT</code>, <code>Cod Intern</code>, <code>Denumire</code>.
                        </p>
                        <input type="file" name="CatalogFile" accept=".xlsx" class="form-input" style="padding: 6px;" />
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <button type="submit" class="btn btn-primary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                            Importa catalog
                        </button>
                    </div>
                </div>
            </form>
            <div style="display: flex; gap: 8px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--c-border-light); flex-wrap: wrap; align-items: center;">
                <form method="post" style="margin:0;">
                    <button type="submit" asp-page-handler="Rematch" class="btn btn-secondary" style="color: var(--c-primary);"
                            onclick="return confirm('Re-asociezi toate documentele cu catalogul curent?')">
                        Re-asociaza toate documentele
                    </button>
                </form>
                <form method="post" style="margin:0;">
                    <button type="submit" asp-page-handler="Reextract" class="btn btn-secondary" style="color: var(--c-primary);"
                            onclick="return confirm('Re-extragi toate documentele cu extractorul curent? (regenereaza JSON-ul canonic si refai matching-ul)')">
                        Re-extrage toate documentele
                    </button>
                </form>
                <form method="post" style="margin:0;">
                    <button type="submit" asp-page-handler="ClearProposedItems" class="btn btn-secondary" style="color: var(--c-danger);"
                            onclick="return confirm('Stergi toate articolele propuse automat de sistem?')">
                        Sterge articole propuse
                    </button>
                </form>
                <span style="font-size: 12px; color: var(--c-text-muted);">@Model.ProposedItemCount articol(e) propuse</span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="section-title" style="margin-top: 0;">Gestiuni si Centre de cost</div>
            <div class="stat-cards" style="grid-template-columns: 1fr 1fr; margin-bottom: 16px;">
                <div class="stat-card">
                    <div class="stat-card-label">Gestiuni</div>
                    <div class="stat-card-value" style="font-size: 22px;">@Model.WarehouseCount</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card-label">Centre de cost</div>
                    <div class="stat-card-value" style="font-size: 22px;">@Model.CostCenterCount</div>
                </div>
            </div>
            <form method="post" asp-page-handler="ImportWarehouses" enctype="multipart/form-data" style="margin-bottom: 16px;">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label class="field-label">Import gestiuni (XLSX: coloana Gestiune)</label>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <input type="file" name="WarehouseFile" accept=".xlsx" class="form-input" style="padding: 6px;" />
                        <button type="submit" class="btn btn-primary" style="white-space: nowrap;">Importa gestiuni</button>
                    </div>
                </div>
            </form>
            <form method="post" asp-page-handler="ImportCostCenters" enctype="multipart/form-data">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label class="field-label">Import centre de cost (CSV: COD, DENUMIRE)</label>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <input type="file" name="CostCenterFile" accept=".csv,.txt,.tsv" class="form-input" style="padding: 6px;" />
                        <button type="submit" class="btn btn-primary" style="white-space: nowrap;">Importa centre cost</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="section-title" style="margin-top: 0;">Declaratii vamale (DVI)</div>
            <p style="font-size:12px; color:var(--c-text-muted); margin-bottom: 10px;">
                Pune fisierele PDF in folderul <code>DVI/</code> din directorul aplicatiei — sunt importate automat la fiecare scanare (~30s).
                MRN, LRN (ultimele 3 cifre), cursul de schimb si data liberului vamal se extrag automat.
            </p>
            <div style="display:flex; gap:8px; flex-wrap: wrap;">
                <form method="post" asp-page-handler="ImportDvi" style="margin:0;">
                    <button type="submit" class="btn btn-primary">Scaneaza folder acum</button>
                </form>
                <form method="post" asp-page-handler="ClearDvi" style="margin:0;"
                      onsubmit="return confirm('Stergi toate DVI-urile? Documentele atasate vor ramane fara DVI.');">
                    <button type="submit" class="btn btn-secondary" style="color: var(--c-danger);">Sterge toate DVI-urile</button>
                </form>
            </div>
            <div style="margin-top: 12px; font-size: 12px; color: var(--c-text-muted);">
                Declaratii in evidenta: <strong>@Model.DviCount</strong>
            </div>
            @if (Model.DviCount > 0)
            {
                <table class="data-table" id="dviTable" style="margin-top: 10px; font-size: 12px;">
                    <thead>
                        <tr>
                            <th style="width:180px;">Fisier</th>
                            <th>MRN</th>
                            <th style="width:60px;">LRN</th>
                            <th style="width:80px;">Curs</th>
                            <th style="width:90px;">Liber vama</th>
                            <th style="width:60px;"></th>
                        </tr>
                    </thead>
                    <tbody id="dviTableBody">
                        <tr><td colspan="6" style="text-align:center; color:var(--c-text-muted); padding:10px;">Se incarca...</td></tr>
                    </tbody>
                </table>
                <script>
                    fetch('/ui/customs-declarations').then(r => r.json()).then(function (items) {
                        var tbody = document.getElementById('dviTableBody');
                        if (!items.length) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--c-text-muted); padding:10px;">Niciun DVI.</td></tr>'; return; }
                        tbody.innerHTML = items.map(function (d) {
                            var rel = d.releaseDate ? new Date(d.releaseDate) : null;
                            var relStr = rel ? ('0' + rel.getDate()).slice(-2) + '.' + ('0' + (rel.getMonth() + 1)).slice(-2) + '.' + rel.getFullYear() : '—';
                            return '<tr data-id="' + d.id + '">' +
                                '<td>' + (d.filename || '') + '</td>' +
                                '<td style="font-family:var(--font-mono);">' + (d.mrn || '—') + '</td>' +
                                '<td style="font-family:var(--font-mono);">' + (d.lrn || '—') + '</td>' +
                                '<td style="font-family:var(--font-mono);">' + (d.exchangeRate != null ? Number(d.exchangeRate).toFixed(4) : '—') + '</td>' +
                                '<td>' + relStr + '</td>' +
                                '<td><button type="button" class="btn-icon dvi-del" title="Sterge">&times;</button></td>' +
                                '</tr>';
                        }).join('');
                        tbody.querySelectorAll('.dvi-del').forEach(function (btn) {
                            btn.addEventListener('click', function () {
                                var row = btn.closest('tr');
                                if (!confirm('Stergi DVI "' + row.cells[0].textContent + '"?')) return;
                                fetch('/ui/customs-declarations/' + row.dataset.id, { method: 'DELETE' })
                                    .then(function (r) { if (r.ok) { row.remove(); } });
                            });
                        });
                    });
                </script>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="section-title" style="margin-top: 0;">Clase caracterizare articole</div>
            <div class="stat-cards" style="grid-template-columns: 1fr; margin-bottom: 16px;">
                <div class="stat-card">
                    <div class="stat-card-label">Clase in nomenclator</div>
                    <div class="stat-card-value" style="font-size: 22px;">@Model.ItemClassCount</div>
                </div>
            </div>
            <form method="post" asp-page-handler="ImportItemClasses" enctype="multipart/form-data">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label class="field-label">Import clase articole (XLSX: NrCrt, Denumire, Simbol, Nivel)</label>
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <input type="file" name="ItemClassFile" accept=".xlsx" class="form-input" style="padding: 6px;" />
                        <button type="submit" class="btn btn-primary" style="white-space: nowrap;">Importa clase</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .form-input { padding: 8px 12px; border: 1px solid var(--c-border); border-radius: var(--radius); font-size: 14px; width: 100%; font-family: inherit; background: var(--c-surface); color: var(--c-text); }
    .form-input:focus { outline: none; border-color: var(--c-primary); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
</style>

<script>
    document.querySelectorAll('.edit-supplier-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('editId').value = btn.dataset.id;
            document.getElementById('nameInput').value = btn.dataset.name;
            document.getElementById('erpNameInput').value = btn.dataset.erp || '';
            document.getElementById('vatInput').value = btn.dataset.vat || '';
            document.getElementById('countryInput').value = btn.dataset.country || '';
            document.getElementById('aliasesInput').value = btn.dataset.aliases || '';
            document.getElementById('invoiceTypeInput').value = btn.dataset.invoicetype || 'Intern';
            document.getElementById('taxationTypeInput').value = btn.dataset.taxationtype || 'TaxareNormala';
            document.getElementById('transactionTypeInput').value = btn.dataset.transactiontype || 'TranzactieInterna';
            document.getElementById('formTitle').textContent = 'Editeaza furnizor';
            document.getElementById('saveBtnText').textContent = 'Salveaza';
            document.getElementById('deleteBtn').style.display = '';
            document.getElementById('cancelBtn').style.display = '';
        });
    });

    document.getElementById('cancelBtn').addEventListener('click', function () {
        document.getElementById('editId').value = '';
        document.getElementById('nameInput').value = '';
        document.getElementById('erpNameInput').value = '';
        document.getElementById('vatInput').value = '';
        document.getElementById('countryInput').value = '';
        document.getElementById('aliasesInput').value = '';
        document.getElementById('invoiceTypeInput').value = 'Intern';
        document.getElementById('taxationTypeInput').value = 'TaxareNormala';
        document.getElementById('transactionTypeInput').value = 'TranzactieInterna';
        document.getElementById('formTitle').textContent = 'Adauga furnizor';
        document.getElementById('saveBtnText').textContent = 'Adauga';
        document.getElementById('deleteBtn').style.display = 'none';
        document.getElementById('cancelBtn').style.display = 'none';
    });

    (function () {
        var searchInput = document.getElementById('catalogSearchInput');
        var resultsDiv = document.getElementById('catalogSearchResults');
        var debounceTimer = null;

        searchInput.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            var q = searchInput.value.trim();
            if (q.length < 2) { resultsDiv.style.display = 'none'; return; }

            debounceTimer = setTimeout(function () {
                fetch('/ui/catalog/search?q=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (items) {
                        if (items.length === 0) {
                            resultsDiv.innerHTML = '<div style="padding:12px; text-align:center; color:var(--c-text-muted); font-size:13px;">Niciun rezultat gasit.</div>';
                        } else {
                            resultsDiv.innerHTML = '<table style="width:100%; border-collapse:collapse; font-size:13px;">' +
                                '<thead><tr style="border-bottom:1px solid var(--c-border);">' +
                                '<th style="padding:6px 10px; text-align:left; font-size:11px; color:var(--c-text-muted);">Cod</th>' +
                                '<th style="padding:6px 10px; text-align:left; font-size:11px; color:var(--c-text-muted);">Denumire</th>' +
                                '<th style="padding:6px 10px; text-align:left; font-size:11px; color:var(--c-text-muted);">UM</th>' +
                                '</tr></thead><tbody>' +
                                items.map(function (it) {
                                    return '<tr style="border-bottom:1px solid var(--c-border-light);">' +
                                        '<td style="padding:5px 10px; font-family:var(--font-mono); font-weight:600;">' + (it.erpItemCode || '-') + '</td>' +
                                        '<td style="padding:5px 10px;">' + (it.name || '-') + '</td>' +
                                        '<td style="padding:5px 10px;">' + (it.uom || '-') + '</td></tr>';
                                }).join('') +
                                '</tbody></table>';
                        }
                        resultsDiv.style.display = '';
                    });
            }, 300);
        });
    })();
</script>
