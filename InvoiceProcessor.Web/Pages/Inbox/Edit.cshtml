@page "/Inbox/Edit/{id:guid}"
@model InvoiceProcessor.Web.Pages.Inbox.EditModel

<style>
    .form-input { padding: 8px 12px; border: 1px solid var(--c-border); border-radius: var(--radius); font-size: 14px; width: 100%; font-family: inherit; background: var(--c-surface); color: var(--c-text); }
    .form-input:focus { outline: none; border-color: var(--c-primary); box-shadow: 0 0 0 3px rgba(37,99,235,0.1); }
    .form-input-sm { padding: 6px 8px; font-size: 13px; }
    .form-input-num { text-align: right; font-family: var(--font-mono); font-size: 13px; }
    .edit-container { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; height: calc(100vh - 140px); }
    .edit-panel { background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius-lg); overflow-y: auto; padding: 24px; box-shadow: var(--shadow); }
    .edit-lines-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .edit-lines-table th { text-align: left; padding: 6px 6px; font-size: 11px; font-weight: 600; color: var(--c-text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--c-border); }
    .edit-lines-table td { padding: 4px 4px; }
    .edit-lines-table input { width: 100%; }
    .btn-icon { padding: 6px 8px; border: none; background: none; cursor: pointer; color: var(--c-danger); font-size: 16px; border-radius: 4px; }
    .btn-icon:hover { background: var(--c-danger-bg); }
    .btn-add-line { margin-top: 8px; }
    .edit-validation { padding: 12px 16px; border-radius: var(--radius); margin-top: 16px; font-size: 14px; font-weight: 600; }
    .edit-validation.valid { background: var(--c-success-bg); color: var(--c-success); }
    .edit-validation.invalid { background: var(--c-danger-bg); color: var(--c-danger); }
    .edit-lines-table td.line-ok input { background: #e6f9ed; }
    .edit-lines-table td.line-err input { background: #fde8e8; }
</style>

<div class="preview-topbar">
    <h2>Editare: @(Model.Doc.InvoiceNo ?? Model.Doc.Filename)</h2>
    <div style="display: flex; gap: 8px;">
        <a href="/Inbox/Preview/@Model.Doc.Id" class="btn btn-secondary">Previzualizare</a>
        <a href="/Inbox" class="btn btn-secondary">Inapoi la Inbox</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success" style="margin-bottom: 12px;">@Model.Message</div>
}

<form method="post">
    <div class="edit-container">
        <div class="pdf-panel">
            <iframe src="/ui/documents/@Model.Doc.Id/pdf#toolbar=1&navpanes=0&view=FitH"></iframe>
        </div>

        <div class="edit-panel">
            <div class="section-title">Detalii factura</div>
            <div class="field-grid">
                <div class="field">
                    <div class="field-label">Furnizor</div>
                    <input type="text" name="Supplier" value="@Model.Supplier" class="form-input" />
                </div>
                <div class="field">
                    <div class="field-label">Nr. factura</div>
                    <input type="text" name="InvoiceNo" value="@Model.InvoiceNo" class="form-input" />
                </div>
                <div class="field">
                    <div class="field-label">Data</div>
                    <input type="date" name="InvoiceDate" value="@Model.InvoiceDate" class="form-input" />
                </div>
                <div class="field">
                    <div class="field-label">Moneda</div>
                    <input type="text" name="Currency" value="@Model.Currency" class="form-input" />
                </div>
                <div class="field">
                    <div class="field-label">Total net</div>
                    <input type="number" step="0.01" name="NetTotal" value="@Model.NetTotal" class="form-input form-input-num" id="netTotalInput" />
                </div>
                <div class="field">
                    <div class="field-label">TVA</div>
                    <input type="number" step="0.01" name="VatTotal" value="@Model.VatTotal" class="form-input form-input-num" />
                </div>
                <div class="field">
                    <div class="field-label">Total brut</div>
                    <input type="number" step="0.01" name="GrossTotal" value="@Model.GrossTotal" class="form-input form-input-num" id="grossTotalInput" />
                </div>
                <div class="field">
                    <div class="field-label">Stare</div>
                    <div class="field-value"><span class="badge @IndexModel.StatusCssClass(Model.Doc.Status)">@IndexModel.StatusDisplayName(Model.Doc.Status)</span></div>
                </div>
            </div>

            <div class="section-title">Linii factura</div>
            <table class="edit-lines-table" id="linesTable">
                <thead>
                    <tr>
                        <th style="width:70px;">Cod</th>
                        <th>Descriere</th>
                        <th style="width:55px;">Bare</th>
                        <th style="width:65px;">Cant.</th>
                        <th style="width:50px;">UM</th>
                        <th style="width:80px;">Pret</th>
                        <th style="width:80px;">Total</th>
                        <th style="width:30px;"></th>
                    </tr>
                </thead>
                <tbody id="linesBody">
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr>
                            <td><input type="text" name="Lines[@i].VendorItemCode" value="@Model.Lines[i].VendorItemCode" class="form-input form-input-sm" /></td>
                            <td><input type="text" name="Lines[@i].DescriptionRaw" value="@Model.Lines[i].DescriptionRaw" class="form-input form-input-sm" /></td>
                            <td><input type="text" name="Lines[@i].Bare" value="@Model.Lines[i].Bare" class="form-input form-input-sm" /></td>
                            <td><input type="number" step="0.01" name="Lines[@i].Qty" value="@Model.Lines[i].Qty" class="form-input form-input-sm form-input-num" /></td>
                            <td><input type="text" name="Lines[@i].Uom" value="@Model.Lines[i].Uom" class="form-input form-input-sm" /></td>
                            <td><input type="number" step="0.0001" name="Lines[@i].UnitPrice" value="@Model.Lines[i].UnitPrice" class="form-input form-input-sm form-input-num" /></td>
                            <td><input type="number" step="0.01" name="Lines[@i].LineTotal" value="@Model.Lines[i].LineTotal" class="form-input form-input-sm form-input-num line-total" /></td>
                            <td><button type="button" class="btn-icon remove-line" title="Sterge linia">&times;</button></td>
                        </tr>
                    }
                </tbody>
            </table>

            <button type="button" class="btn btn-secondary btn-add-line" id="addLineBtn" style="padding: 6px 14px; font-size: 13px;">
                + Adauga linie
            </button>

            <div class="edit-validation" id="validationBar"></div>

            <div class="actions-bar" style="display: flex; gap: 8px; align-items: center;">
                <button type="submit" name="handler" value="Save" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Salveaza
                </button>
                <button type="submit" name="handler" value="SendToRobot" class="btn btn-secondary" style="color: var(--c-primary);"
                        onclick="return confirm('Trimiti factura la robot chiar daca are erori?')">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    Trimite la robot
                </button>
                <a href="/Inbox" class="btn btn-secondary">Anuleaza</a>
            </div>
        </div>
    </div>
</form>

<script>
    // Remove line
    document.getElementById('linesBody').addEventListener('click', function (e) {
        if (e.target.classList.contains('remove-line')) {
            e.target.closest('tr').remove();
            reindex();
            updateValidation();
        }
    });

    // Add line
    document.getElementById('addLineBtn').addEventListener('click', function () {
        var tbody = document.getElementById('linesBody');
        var idx = tbody.rows.length;
        var tr = document.createElement('tr');
        tr.innerHTML =
            '<td><input type="text" name="Lines[' + idx + '].VendorItemCode" class="form-input form-input-sm" /></td>' +
            '<td><input type="text" name="Lines[' + idx + '].DescriptionRaw" class="form-input form-input-sm" /></td>' +
            '<td><input type="text" name="Lines[' + idx + '].Bare" class="form-input form-input-sm" /></td>' +
            '<td><input type="number" step="0.01" name="Lines[' + idx + '].Qty" value="0" class="form-input form-input-sm form-input-num" /></td>' +
            '<td><input type="text" name="Lines[' + idx + '].Uom" value="MTS" class="form-input form-input-sm" /></td>' +
            '<td><input type="number" step="0.0001" name="Lines[' + idx + '].UnitPrice" value="0" class="form-input form-input-sm form-input-num" /></td>' +
            '<td><input type="number" step="0.01" name="Lines[' + idx + '].LineTotal" value="0" class="form-input form-input-sm form-input-num line-total" /></td>' +
            '<td><button type="button" class="btn-icon remove-line" title="Sterge linia">&times;</button></td>';
        tbody.appendChild(tr);
        updateValidation();
    });

    function reindex() {
        var rows = document.getElementById('linesBody').rows;
        for (var i = 0; i < rows.length; i++) {
            var inputs = rows[i].querySelectorAll('input');
            inputs.forEach(function (inp) {
                inp.name = inp.name.replace(/Lines\[\d+\]/, 'Lines[' + i + ']');
            });
        }
    }

    function updateLineValidation() {
        var rows = document.getElementById('linesBody').rows;
        for (var i = 0; i < rows.length; i++) {
            var inputs = rows[i].querySelectorAll('input');
            var qty = parseFloat(inputs[3].value) || 0;
            var price = parseFloat(inputs[5].value);
            var total = parseFloat(inputs[6].value) || 0;
            var totalTd = inputs[6].closest('td');
            if (!isNaN(price) && price !== 0) {
                var expected = qty * price;
                if (Math.abs(expected - total) <= 0.02) {
                    totalTd.className = 'line-ok';
                } else {
                    totalTd.className = 'line-err';
                }
            } else {
                totalTd.className = '';
            }
        }
    }

    function updateValidation() {
        var totals = document.querySelectorAll('.line-total');
        var sum = 0;
        totals.forEach(function (t) { sum += parseFloat(t.value) || 0; });
        var net = parseFloat(document.getElementById('netTotalInput').value) || 0;
        var gross = parseFloat(document.getElementById('grossTotalInput').value) || 0;
        var compareVal = net > 0 ? net : gross;
        var compareLabel = net > 0 ? 'total net' : 'total brut';
        var diff = Math.abs(sum - compareVal);
        var tolerance = Math.max(compareVal * 0.01, 0.50);
        var bar = document.getElementById('validationBar');
        if (compareVal === 0) {
            bar.className = 'edit-validation invalid';
            bar.textContent = 'Total lipseste';
        } else if (diff <= tolerance) {
            bar.className = 'edit-validation valid';
            bar.textContent = '\u2713 Suma linii (' + sum.toFixed(2) + ') = ' + compareLabel + ' (' + compareVal.toFixed(2) + ')';
        } else {
            bar.className = 'edit-validation invalid';
            bar.textContent = '\u2717 Suma linii (' + sum.toFixed(2) + ') \u2260 ' + compareLabel + ' (' + compareVal.toFixed(2) + ') — diferenta: ' + diff.toFixed(2);
        }
        updateLineValidation();
    }

    // Live validation on any input change in the edit panel
    document.querySelector('.edit-panel').addEventListener('input', function () {
        updateValidation();
    });

    updateValidation();
</script>
