@page "/Inbox"
@model InvoiceProcessor.Web.Pages.Inbox.IndexModel

<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
    <div class="page-header" style="margin-bottom: 0;">
        <h1 class="page-title">Inbox</h1>
        <p class="page-subtitle">Facturi primite, grupate pe furnizor</p>
    </div>
    <form method="post">
        <button type="submit" asp-page-handler="Refresh" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            Reimporta fisiere
        </button>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (Model.SupplierGroups.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
            <p>Niciun document in inbox.<br/>Adauga fisiere PDF in folderul <code>samples/</code> si apasa <strong>Reimporta fisiere</strong>.</p>
        </div>
    </div>
}
else
{
    <form method="post" asp-page-handler="SendJob" id="sendJobForm">
        @foreach (var group in Model.SupplierGroups)
        {
            <details class="supplier-group" @(group.ReadyCount > 0 ? "open" : "")>
                <summary class="supplier-header">
                    <svg class="supplier-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    <span class="supplier-name">@group.SupplierName</span>
                    @if (group.SupplierVat != null)
                    {
                        <span class="supplier-vat">@group.SupplierVat</span>
                    }
                    <span class="supplier-counts">
                        <span class="count-total">@group.TotalCount factura(e)</span>
                        @if (group.ReadyCount > 0)
                        {
                            <span class="badge status-ready">@group.ReadyCount gata</span>
                        }
                        @if (group.ReviewCount > 0)
                        {
                            <span class="badge status-review">@group.ReviewCount verificare</span>
                        }
                        @if (group.ProcessingCount > 0)
                        {
                            <span class="badge status-processing">@group.ProcessingCount procesare</span>
                        }
                    </span>
                </summary>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="col-check">
                                <input type="checkbox" class="select-all-supplier" title="Selecteaza tot" />
                            </th>
                            <th>Nr. factura</th>
                            <th>Data</th>
                            <th>Total</th>
                            <th>Tip</th>
                            <th>Stare</th>
                            <th>Catalog / Noi</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in group.Documents)
                        {
                            var selectable = IndexModel.IsSelectable(doc);
                            <tr>
                                <td class="col-check">
                                    @if (selectable && doc.TransferBlocked)
                                    {
                                        <input type="checkbox" disabled title="Transfer blocat: verificarile de extractie au esuat (numar linii / total). Deschideti Previzualizare pentru detalii." />
                                    }
                                    else if (selectable)
                                    {
                                        var pendingCount = IndexModel.GetPendingItemsCount(doc);
                                        <input type="checkbox" name="SelectedDocumentIds" value="@doc.Id" data-pending="@pendingCount" data-invoice="@(doc.InvoiceNo ?? doc.Filename)" />
                                    }
                                </td>
                                <td style="font-weight:600;">@(doc.InvoiceNo ?? doc.Filename)</td>
                                <td>@doc.InvoiceDate?.ToString("dd/MM/yyyy")</td>
                                <td class="num">@doc.GrossTotal?.ToString("N2")</td>
                                <td>
                                    @if (doc.Supplier?.InvoiceType == InvoiceProcessor.Web.Enums.InvoiceType.Import)
                                    {
                                        <span class="badge" style="background:#fef3e2; color:#b45309; border:1px solid #f59e0b;">Import</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#e0f2fe; color:#0369a1;">Intern</span>
                                    }
                                </td>
                                <td><span class="badge @IndexModel.StatusCssClass(doc.Status)">@IndexModel.StatusDisplayName(doc.Status)</span></td>
                                @{
                                    var stats = IndexModel.GetMatchStats(doc);
                                    var newCount = IndexModel.GetPendingItemsCount(doc);
                                    var foundCount = stats.total - newCount;
                                }
                                <td class="num"
                                    style="@(stats.total == 0 ? "color: var(--c-text-muted);" : newCount > 0 ? "color: #e67e22; font-weight: 600;" : "color: var(--c-success); font-weight: 600;")"
                                    title="@(newCount > 0 ? newCount + " articole noi - fereastra de validare se va deschide la trimitere" : "Toate articolele sunt in catalog - trimitere directa, fara fereastra")">
                                    @(stats.total > 0 ? $"{foundCount}/{newCount}" : "-")
                                </td>
                                <td>
                                    <span class="row-actions">
                                        <a href="/Inbox/Edit/@doc.Id">Editeaza</a>
                                        <a href="/Inbox/Preview/@doc.Id">Previzualizare</a>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>
        }

        <div class="actions-bar">
            <button type="submit" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                Trimite selectia la robot
            </button>
        </div>
    </form>

    <partial name="_NewItemsModal" />

    <script>
        // --- Select-all per supplier table ---
        document.querySelectorAll('.select-all-supplier').forEach(function (masterCb) {
            var table = masterCb.closest('table');
            var rowCbs = table.querySelectorAll('tbody input[type="checkbox"]');

            masterCb.addEventListener('change', function () {
                rowCbs.forEach(function (cb) { cb.checked = masterCb.checked; });
            });

            rowCbs.forEach(function (cb) {
                cb.addEventListener('change', function () {
                    var allChecked = Array.from(rowCbs).every(function (c) { return c.checked; });
                    var anyChecked = Array.from(rowCbs).some(function (c) { return c.checked; });
                    masterCb.checked = allChecked;
                    masterCb.indeterminate = !allChecked && anyChecked;
                });
            });
        });

        // --- New-items step-through before posting to robot ---
        (function () {
            var form = document.getElementById('sendJobForm');
            if (!form) return;
            var bypass = false; // set true once new items are resolved → allow the real submit

            form.addEventListener('submit', function (e) {
                if (bypass) return;
                var queue = [];
                form.querySelectorAll('input[name="SelectedDocumentIds"]:checked').forEach(function (cb) {
                    if (parseInt(cb.dataset.pending || '0', 10) > 0)
                        queue.push({ docId: cb.value, invoiceNo: cb.dataset.invoice || cb.value });
                });
                if (queue.length === 0) return; // no new items — post normally
                e.preventDefault();
                window.NewItemsModal.run(queue, function () { bypass = true; form.submit(); });
            });
        })();
    </script>
}
