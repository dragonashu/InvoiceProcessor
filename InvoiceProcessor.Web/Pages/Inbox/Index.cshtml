@page "/Inbox"
@model InvoiceProcessor.Web.Pages.Inbox.IndexModel

<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
    <div class="page-header" style="margin-bottom: 0;">
        <h1 class="page-title">Inbox</h1>
        <p class="page-subtitle">Facturi primite, grupate pe furnizor</p>
    </div>
    <form method="post">
        <button type="submit" asp-page-handler="Refresh" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            Reimporta fisiere
        </button>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (Model.NewItemsCount > 0)
{
    <details class="card" style="margin-bottom: 24px; border-left: 4px solid #e67e22;" open>
        <summary style="padding: 16px 20px; cursor: pointer; font-weight: 600; color: #e67e22; display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e67e22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            @Model.NewItemsCount articol(e) noi propuse de sistem — necesita verificare
        </summary>
        <div style="padding: 0 20px 16px;">
            <p style="font-size: 12px; color: var(--c-text-muted); margin-bottom: 12px;">
                Aceste articole au fost create automat deoarece nu s-au gasit in nomenclator. Verificati codul ERP, denumirea si UM, apoi acceptati sau respingeti.
            </p>
            <datalist id="itemClassList"></datalist>
            <table class="data-table" id="newItemsTable">
                <thead>
                    <tr>
                        <th>Cod intern</th>
                        <th>Denumire</th>
                        <th>UM</th>
                        <th>Clasa</th>
                        <th>Cod extern</th>
                        <th>Sursa</th>
                        <th style="width:160px;"></th>
                    </tr>
                </thead>
                <tbody id="newItemsBody">
                    <tr><td colspan="7" style="text-align:center; color: var(--c-text-muted); padding: 12px;">Se incarca...</td></tr>
                </tbody>
            </table>
        </div>
    </details>
    <style>
        #newItemsTable input { padding: 5px 8px; font-size: 13px; border: 1px solid var(--c-border); border-radius: var(--radius); width: 100%; font-family: inherit; background: var(--c-surface); color: var(--c-text); }
        #newItemsTable input:focus { outline: none; border-color: #e67e22; box-shadow: 0 0 0 2px rgba(230,126,34,0.15); }
        .btn-accept { padding: 4px 10px; font-size: 12px; border: 1px solid var(--c-success); background: var(--c-success-bg); color: var(--c-success); border-radius: var(--radius); cursor: pointer; font-weight: 600; }
        .btn-accept:hover { background: var(--c-success); color: white; }
        .btn-reject { padding: 4px 10px; font-size: 12px; border: 1px solid var(--c-danger); background: none; color: var(--c-danger); border-radius: var(--radius); cursor: pointer; }
        .btn-reject:hover { background: var(--c-danger-bg); }
        .pdf-modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center; }
        .pdf-modal-overlay.active { display: flex; }
        .pdf-modal { background: var(--c-surface); border-radius: var(--radius-lg); box-shadow: 0 20px 60px rgba(0,0,0,0.3); width: 80vw; height: 85vh; display: flex; flex-direction: column; }
        .pdf-modal-header { padding: 12px 20px; border-bottom: 1px solid var(--c-border); display: flex; justify-content: space-between; align-items: center; }
        .pdf-modal-header h3 { font-size: 15px; margin: 0; }
        .pdf-modal iframe { flex: 1; border: none; border-radius: 0 0 var(--radius-lg) var(--radius-lg); }
    </style>

    <div class="pdf-modal-overlay" id="pdfPreviewModal">
        <div class="pdf-modal">
            <div class="pdf-modal-header">
                <h3>Previzualizare factura</h3>
                <button type="button" class="btn btn-secondary" style="padding: 4px 12px; font-size: 13px;"
                        onclick="closePdfModal()">Inchide</button>
            </div>
            <div id="pdfPreviewItemInfo" style="display:none; padding:10px 20px; background:#fef3e2; border-bottom:1px solid #e67e22; font-size:13px;">
                <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
                    <span style="font-weight:600; color:#e67e22;">Linia <span id="pdfPreviewLineNo"></span></span>
                    <label style="font-size:11px; color:var(--c-text-muted);">Cod intern</label>
                    <input type="text" id="pdfPreviewCode" style="padding:4px 8px; font-size:12px; border:1px solid var(--c-border); border-radius:var(--radius); width:100px; font-family:var(--font-mono);" />
                    <label style="font-size:11px; color:var(--c-text-muted);">Denumire</label>
                    <input type="text" id="pdfPreviewName" style="padding:4px 8px; font-size:12px; border:1px solid var(--c-border); border-radius:var(--radius); width:220px;" />
                    <label style="font-size:11px; color:var(--c-text-muted);">UM</label>
                    <input type="text" id="pdfPreviewUom" style="padding:4px 8px; font-size:12px; border:1px solid var(--c-border); border-radius:var(--radius); width:50px;" />
                    <label style="font-size:11px; color:var(--c-text-muted);">Clasa</label>
                    <input type="text" id="pdfPreviewClass" list="itemClassList" style="padding:4px 8px; font-size:12px; border:1px solid var(--c-border); border-radius:var(--radius); width:220px; font-weight:600;" />
                    <label style="font-size:11px; color:var(--c-text-muted);">Cod extern</label>
                    <input type="text" id="pdfPreviewExtCode" style="padding:4px 8px; font-size:12px; border:1px solid var(--c-border); border-radius:var(--radius); width:130px; font-family:var(--font-mono);" />
                    <button type="button" class="btn-accept" id="pdfPreviewAcceptBtn">Accepta</button>
                </div>
            </div>
            <iframe id="pdfPreviewFrame" src=""></iframe>
        </div>
    </div>
    <script>
        (function () {
            fetch('/ui/item-classes').then(r => r.json()).then(function (classes) {
                var dl = document.getElementById('itemClassList');
                if (dl) dl.innerHTML = classes.map(function (n) { return '<option value="' + n.replace(/"/g, '&quot;') + '"></option>'; }).join('');
            }).catch(function () { });
            fetch('/ui/catalog/new-items').then(r => r.json()).then(function (items) {
                var tbody = document.getElementById('newItemsBody');
                if (items.length === 0) { tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--c-text-muted); padding:12px;">Niciun articol nou.</td></tr>'; return; }
                tbody.innerHTML = items.map(function (it) {
                    var srcHtml = '-';
                    if (it.documentId) {
                        srcHtml = '<a href="#" class="pdf-preview-link" data-docid="' + it.documentId + '" data-lineno="' + (it.lineNo || '') + '" style="font-size:12px; color:var(--c-primary);">' +
                            (it.invoiceNo || 'PDF') + (it.lineNo ? ' #' + it.lineNo : '') + '</a>';
                    }
                    return '<tr data-id="' + it.id + '">' +
                        '<td><input type="text" class="ni-erp" value="' + (it.erpItemCode || '').replace(/"/g, '&quot;') + '" /></td>' +
                        '<td><input type="text" class="ni-name" value="' + (it.name || '').replace(/"/g, '&quot;') + '" /></td>' +
                        '<td><input type="text" class="ni-uom" value="' + (it.uom || '').replace(/"/g, '&quot;') + '" style="width:60px;" /></td>' +
                        '<td><input type="text" class="ni-class" list="itemClassList" value="' + (it.propertyClass || '').replace(/"/g, '&quot;') + '" style="width:220px; font-weight:600;" /></td>' +
                        '<td><input type="text" class="ni-ext" value="' + (it.externalCode || '').replace(/"/g, '&quot;') + '" style="width:120px; font-family:var(--font-mono);" /></td>' +
                        '<td>' + srcHtml + '</td>' +
                        '<td style="display:flex; gap:4px;">' +
                            '<button class="btn-accept" onclick="acceptItem(this)">Accepta</button>' +
                            '<button class="btn-reject" onclick="rejectItem(this)">Respinge</button>' +
                        '</td></tr>';
                }).join('');

                // Bind PDF preview links
                tbody.querySelectorAll('.pdf-preview-link').forEach(function (a) {
                    a.addEventListener('click', function (e) {
                        e.preventDefault();
                        var row = a.closest('tr');
                        var docId = a.dataset.docid;
                        var lineNo = a.dataset.lineno;
                        var itemId = row.dataset.id;
                        openPdfModal(docId, itemId, lineNo,
                            row.querySelector('.ni-erp').value,
                            row.querySelector('.ni-name').value,
                            row.querySelector('.ni-uom').value,
                            row.querySelector('.ni-ext').value,
                            row.querySelector('.ni-class').value,
                            row);
                    });
                });
            });
        })();

        function acceptItem(btn) {
            var row = btn.closest('tr');
            var id = row.dataset.id;
            var data = { erpItemCode: row.querySelector('.ni-erp').value, name: row.querySelector('.ni-name').value, uom: row.querySelector('.ni-uom').value, externalCode: row.querySelector('.ni-ext').value, propertyClass: row.querySelector('.ni-class').value };
            fetch('/ui/catalog/new-items/' + id + '/accept', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
                .then(function (r) {
                    if (r.ok) {
                        row.style.background = '#e6f9ed';
                        row.style.transition = 'opacity 0.5s, transform 0.5s';
                        row.querySelector('td:last-child').innerHTML = '<span style="color:var(--c-success);font-weight:600;">Acceptat</span>';
                        setTimeout(function () {
                            row.style.opacity = '0';
                            row.style.transform = 'translateX(30px)';
                            setTimeout(function () { row.remove(); updateNewItemsCount(); }, 500);
                        }, 600);
                    }
                });
        }

        function updateNewItemsCount() {
            var remaining = document.querySelectorAll('#newItemsBody tr[data-id]').length;
            if (remaining === 0) {
                document.getElementById('newItemsBody').innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--c-text-muted); padding:12px;">Toate articolele au fost procesate.</td></tr>';
            }
        }

        var _pdfModalRow = null;
        function openPdfModal(docId, itemId, lineNo, code, name, uom, extCode, propClass, sourceRow) {
            _pdfModalRow = sourceRow;
            document.getElementById('pdfPreviewFrame').src = '/ui/documents/' + docId + '/pdf#toolbar=1&navpanes=0&view=FitH';
            var info = document.getElementById('pdfPreviewItemInfo');
            info.style.display = '';
            info.dataset.itemId = itemId;
            document.getElementById('pdfPreviewLineNo').textContent = lineNo || '?';
            document.getElementById('pdfPreviewCode').value = code;
            document.getElementById('pdfPreviewName').value = name;
            document.getElementById('pdfPreviewUom').value = uom;
            document.getElementById('pdfPreviewClass').value = propClass || '';
            document.getElementById('pdfPreviewExtCode').value = extCode || '';
            document.getElementById('pdfPreviewModal').classList.add('active');
        }
        function closePdfModal() {
            document.getElementById('pdfPreviewModal').classList.remove('active');
            document.getElementById('pdfPreviewFrame').src = '';
        }
        document.getElementById('pdfPreviewModal').addEventListener('click', function (e) {
            if (e.target === this) closePdfModal();
        });
        document.getElementById('pdfPreviewAcceptBtn').addEventListener('click', function () {
            var info = document.getElementById('pdfPreviewItemInfo');
            var id = info.dataset.itemId;
            var data = { erpItemCode: document.getElementById('pdfPreviewCode').value, name: document.getElementById('pdfPreviewName').value, uom: document.getElementById('pdfPreviewUom').value, externalCode: document.getElementById('pdfPreviewExtCode').value, propertyClass: document.getElementById('pdfPreviewClass').value };
            fetch('/ui/catalog/new-items/' + id + '/accept', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
                .then(function (r) {
                    if (r.ok && _pdfModalRow) {
                        _pdfModalRow.style.background = '#e6f9ed';
                        _pdfModalRow.style.transition = 'opacity 0.5s, transform 0.5s';
                        _pdfModalRow.querySelector('td:last-child').innerHTML = '<span style="color:var(--c-success);font-weight:600;">Acceptat</span>';
                        var row = _pdfModalRow;
                        setTimeout(function () {
                            row.style.opacity = '0';
                            row.style.transform = 'translateX(30px)';
                            setTimeout(function () { row.remove(); updateNewItemsCount(); }, 500);
                        }, 400);
                    }
                    closePdfModal();
                });
        });

        function rejectItem(btn) {
            if (!confirm('Respingi acest articol?')) return;
            var row = btn.closest('tr');
            var id = row.dataset.id;
            fetch('/ui/catalog/new-items/' + id, { method: 'DELETE' })
                .then(function (r) { if (r.ok) { row.style.opacity = '0.3'; row.querySelector('td:last-child').innerHTML = '<span style="color:var(--c-danger);">Respins</span>'; } });
        }
    </script>
}

@if (Model.SupplierGroups.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
            <p>Niciun document in inbox.<br/>Adauga fisiere PDF in folderul <code>samples/</code> si asteapta urmatorul ciclu de procesare.</p>
        </div>
    </div>
}
else
{
    <form method="post" asp-page-handler="SendJob" id="sendJobForm">
        @foreach (var group in Model.SupplierGroups)
        {
            <details class="supplier-group" @(group.ReadyCount > 0 ? "open" : "")>
                <summary class="supplier-header">
                    <svg class="supplier-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    <span class="supplier-name">@group.SupplierName</span>
                    @if (group.SupplierVat != null)
                    {
                        <span class="supplier-vat">@group.SupplierVat</span>
                    }
                    <span class="supplier-counts">
                        <span class="count-total">@group.TotalCount factura(e)</span>
                        @if (group.ReadyCount > 0)
                        {
                            <span class="badge status-ready">@group.ReadyCount gata</span>
                        }
                        @if (group.ReviewCount > 0)
                        {
                            <span class="badge status-review">@group.ReviewCount verificare</span>
                        }
                        @if (group.ProcessingCount > 0)
                        {
                            <span class="badge status-processing">@group.ProcessingCount procesare</span>
                        }
                    </span>
                </summary>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="col-check">
                                <input type="checkbox" class="select-all-supplier" title="Selecteaza tot" />
                            </th>
                            <th>Nr. factura</th>
                            <th>Data</th>
                            <th>Total</th>
                            <th>Tip</th>
                            <th>Stare</th>
                            <th>Mapare</th>
                            <th>Noi</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in group.Documents)
                        {
                            var selectable = IndexModel.IsSelectable(doc);
                            <tr>
                                <td class="col-check">
                                    @if (selectable)
                                    {
                                        var pendingCount = IndexModel.GetPendingItemsCount(doc);
                                        <input type="checkbox" name="SelectedDocumentIds" value="@doc.Id" data-pending="@pendingCount" />
                                    }
                                </td>
                                <td style="font-weight:600;">@(doc.InvoiceNo ?? doc.Filename)</td>
                                <td>@doc.InvoiceDate?.ToString("dd/MM/yyyy")</td>
                                <td class="num">@doc.GrossTotal?.ToString("N2")</td>
                                <td>
                                    @if (doc.Supplier?.InvoiceType == InvoiceProcessor.Web.Enums.InvoiceType.Import)
                                    {
                                        <span class="badge" style="background:#fef3e2; color:#b45309; border:1px solid #f59e0b;">Import</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#e0f2fe; color:#0369a1;">Intern</span>
                                    }
                                </td>
                                <td><span class="badge @IndexModel.StatusCssClass(doc.Status)">@IndexModel.StatusDisplayName(doc.Status)</span></td>
                                @{ var stats = IndexModel.GetMatchStats(doc); }
                                <td class="num" style="@(stats.total == 0 ? "color: var(--c-text-muted);" : stats.matched == stats.total ? "color: var(--c-success); font-weight: 600;" : "color: var(--c-warning); font-weight: 600;")">
                                    @(stats.total > 0 ? $"{stats.matched}/{stats.total}" : "-")
                                </td>
                                <td class="num" style="@(stats.autoCreated > 0 ? "color: #e67e22; font-weight: 600;" : "color: var(--c-text-muted);")">
                                    @(stats.autoCreated > 0 ? stats.autoCreated.ToString() : "-")
                                </td>
                                <td>
                                    <span class="row-actions">
                                        <a href="/Inbox/Edit/@doc.Id">Editeaza</a>
                                        <a href="/Inbox/Preview/@doc.Id">Previzualizare</a>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>
        }

        <div class="actions-bar">
            <button type="submit" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                Trimite selectia la robot
            </button>
        </div>
    </form>

    <div class="pending-confirm-overlay" id="pendingConfirmModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
        <div style="background:var(--c-surface); border-radius:var(--radius-lg); box-shadow:0 20px 60px rgba(0,0,0,0.3); width:480px; max-width:90vw; padding:24px;">
            <div style="display:flex; gap:12px; align-items:flex-start; margin-bottom:16px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e67e22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <div>
                    <h3 style="margin:0 0 8px 0; font-size:16px; color:#e67e22;">Articole neacceptate</h3>
                    <p style="margin:0; font-size:13px; line-height:1.5; color:var(--c-text);">
                        Sunt articole neacceptate inca. Sunteti sigur ca vreti sa continuati? Aceste linii din factura nu vor fi introduse automat.
                    </p>
                    <p id="pendingConfirmDetail" style="margin:10px 0 0 0; font-size:12px; color:var(--c-text-muted);"></p>
                </div>
            </div>
            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button type="button" class="btn btn-secondary" id="pendingConfirmCancel">Anuleaza</button>
                <button type="button" class="btn btn-primary" id="pendingConfirmContinue">Continua</button>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('.select-all-supplier').forEach(function (masterCb) {
            var table = masterCb.closest('table');
            var rowCbs = table.querySelectorAll('tbody input[type="checkbox"]');

            masterCb.addEventListener('change', function () {
                rowCbs.forEach(function (cb) { cb.checked = masterCb.checked; });
            });

            rowCbs.forEach(function (cb) {
                cb.addEventListener('change', function () {
                    var allChecked = Array.from(rowCbs).every(function (c) { return c.checked; });
                    var anyChecked = Array.from(rowCbs).some(function (c) { return c.checked; });
                    masterCb.checked = allChecked;
                    masterCb.indeterminate = !allChecked && anyChecked;
                });
            });
        });

        (function () {
            var form = document.getElementById('sendJobForm');
            var modal = document.getElementById('pendingConfirmModal');
            if (!form || !modal) return;
            var detail = document.getElementById('pendingConfirmDetail');
            var cancelBtn = document.getElementById('pendingConfirmCancel');
            var continueBtn = document.getElementById('pendingConfirmContinue');
            var bypass = false;

            form.addEventListener('submit', function (e) {
                if (bypass) return;
                var selected = form.querySelectorAll('input[name="SelectedDocumentIds"]:checked');
                var docsWithPending = 0;
                var totalPendingLines = 0;
                selected.forEach(function (cb) {
                    var n = parseInt(cb.dataset.pending || '0', 10);
                    if (n > 0) { docsWithPending++; totalPendingLines += n; }
                });
                if (docsWithPending > 0) {
                    e.preventDefault();
                    detail.textContent = docsWithPending + ' factura/i cu ' + totalPendingLines + ' linie/i ce vor fi omise.';
                    modal.style.display = 'flex';
                }
            });

            cancelBtn.addEventListener('click', function () { modal.style.display = 'none'; });
            modal.addEventListener('click', function (e) { if (e.target === modal) modal.style.display = 'none'; });
            continueBtn.addEventListener('click', function () {
                bypass = true;
                modal.style.display = 'none';
                form.submit();
            });
        })();
    </script>
}
