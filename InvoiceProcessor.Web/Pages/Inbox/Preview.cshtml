@page "/Inbox/Preview/{id:guid}"
@model InvoiceProcessor.Web.Pages.Inbox.PreviewModel

<div class="preview-topbar">
    <h2>@(Model.Doc.InvoiceNo ?? Model.Doc.Filename)</h2>
    <div style="display: flex; gap: 8px;">
        <form method="post" asp-page-handler="SendToRobot" asp-route-id="@Model.Doc.Id" style="margin: 0;">
            <button type="submit" class="btn btn-primary"
                    onclick="return confirm('Trimiti factura la robot?')">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                Trimite la robot
            </button>
        </form>
        <a href="/Inbox/Edit/@Model.Doc.Id" class="btn btn-secondary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editeaza
        </a>
        <a href="/Inbox" class="btn btn-secondary">Inapoi la Inbox</a>
    </div>
</div>

<div class="preview-container">
    <div class="pdf-panel">
        <iframe src="/ui/documents/@Model.Doc.Id/pdf#toolbar=1&navpanes=0&view=FitH"></iframe>
    </div>

    <div class="details-panel">
        @if (Model.Invoice is not null)
        {
            var inv = Model.Invoice;
            var conf = inv.Metadata?.Confidence ?? Model.Doc.Confidence;
            var confClass = conf >= 0.8m ? "confidence-high" : conf >= 0.6m ? "confidence-mid" : "confidence-low";

            <div class="section-title">Detalii factura</div>
            <div class="field-grid">
                <div class="field"><div class="field-label">Furnizor</div><div class="field-value">@(inv.Supplier ?? "Necunoscut")</div></div>
                <div class="field"><div class="field-label">Nr. factura</div><div class="field-value mono">@(inv.InvoiceNo ?? "N/A")</div></div>
                <div class="field"><div class="field-label">Data</div><div class="field-value">@(inv.InvoiceDate?.ToString("dd/MM/yyyy") ?? "N/A")</div></div>
                <div class="field"><div class="field-label">Moneda</div><div class="field-value">@(inv.Currency ?? "N/A")</div></div>
                <div class="field"><div class="field-label">Total net</div><div class="field-value mono">@(inv.NetTotal?.ToString("N2") ?? "N/A")</div></div>
                <div class="field"><div class="field-label">Total brut</div><div class="field-value mono">@(inv.GrossTotal?.ToString("N2") ?? "N/A")</div></div>
                <div class="field"><div class="field-label">Incredere</div><div class="field-value"><span class="confidence-bar"><span class="confidence-track"><span class="confidence-fill @confClass" style="width: @((int)(conf * 100))%;"></span></span>@conf.ToString("P0")</span></div></div>
                <div class="field"><div class="field-label">Stare</div><div class="field-value"><span class="badge @IndexModel.StatusCssClass(Model.Doc.Status)">@IndexModel.StatusDisplayName(Model.Doc.Status)</span></div></div>
            </div>

            @if (inv.Lines.Count > 0)
            {
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px;">
                    <div class="section-title" style="margin: 0;">Linii factura (@inv.Lines.Count)</div>
                    <label style="display: flex; align-items: center; gap: 6px; font-size: 12px; cursor: pointer; user-select: none;">
                        <input type="checkbox" id="toggleDescriptions" />
                        Afiseaza descrieri
                    </label>
                </div>

                var lineSum = inv.Lines.Sum(l => l.LineTotal);
                var compareTotal = inv.NetTotal ?? inv.GrossTotal ?? 0m;
                var compareLabel = inv.NetTotal.HasValue ? "total net" : "total brut";
                var tolerance = Math.Max(compareTotal * 0.01m, 0.5m);
                var sumMatches = compareTotal != 0m && Math.Abs(lineSum - compareTotal) <= tolerance;

                <table class="lines-table" id="linesTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Cod PDF</th>
                            <th class="desc-col" style="display:none;">Descriere PDF</th>
                            <th>Cod ERP</th>
                            <th class="desc-col" style="display:none;">Descriere ERP</th>
                            <th class="num">Cant.</th>
                            <th>UM</th>
                            <th class="num">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var lineNo = 0; }
                        @foreach (var line in inv.Lines)
                        {
                            lineNo++;
                            Model.MatchedLines.TryGetValue(lineNo, out var matchedLine);
                            var matchItem = matchedLine?.MatchedItem;
                            var matchConf = matchedLine?.MatchConfidence ?? 0m;
                            var isAutoCreated = matchedLine?.MatchReason == "auto-created";
                            var matchCss = isAutoCreated ? "color: #e67e22;" : matchConf >= 0.85m ? "color: var(--c-success);" : matchConf >= 0.60m ? "color: var(--c-primary);" : "color: var(--c-text-muted);";
                            var erpCode = matchItem?.ErpItemCode;
                            <tr>
                                <td>@lineNo</td>
                                <td style="font-family: var(--font-mono); font-size: 12px; font-weight: 600;">@(line.VendorItemCode ?? "-")</td>
                                <td class="desc-col" style="display:none; font-size: 12px;">@line.DescriptionRaw</td>
                                <td style="font-family: var(--font-mono); font-size: 12px; font-weight: 600; @matchCss">@(erpCode ?? "-")</td>
                                <td class="desc-col" style="display:none; font-size: 12px; @matchCss">@(matchItem?.Name ?? "-")</td>
                                <td class="num">@line.Qty.ToString("N2")</td>
                                <td>@(line.Uom ?? "-")</td>
                                <td class="num">@line.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="totals-row @(sumMatches ? "validation-pass" : "validation-fail")">
                            <td colspan="100%" style="text-align:right;">
                                <span class="validation-icon">@(sumMatches ? "\u2713" : "\u2717")</span>
                                Suma linii vs @compareLabel (@compareTotal.ToString("N2"))
                                &nbsp; <strong>@lineSum.ToString("N2")</strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
            }
        }
        else
        {
            <div class="section-title">Informatii document</div>
            <div class="field-grid">
                <div class="field"><div class="field-label">Fisier</div><div class="field-value">@Model.Doc.Filename</div></div>
                <div class="field"><div class="field-label">Stare</div><div class="field-value"><span class="badge @IndexModel.StatusCssClass(Model.Doc.Status)">@IndexModel.StatusDisplayName(Model.Doc.Status)</span></div></div>
            </div>
            <div class="empty-state"><p>Nu exista date extrase momentan.</p></div>
        }
    </div>
</div>

<script>
    document.getElementById('toggleDescriptions')?.addEventListener('change', function () {
        var cols = document.querySelectorAll('.desc-col');
        cols.forEach(function (c) { c.style.display = this.checked ? '' : 'none'; }.bind(this));
    });
</script>
